# Environment Variables — Oluwaseun Website
# Copy this file to .env.local and fill in real values.
# Never commit .env.local to version control.

# ─── WhatsApp Integration ──────────────────────────────────────────
# International phone number in digits only — no +, spaces, or dashes.
# Example: 2348012345678
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ─── Site URL ──────────────────────────────────────────────────────
# Used for canonical URLs, Open Graph, and sitemap generation.
# Example: https://oluwaseun.dev
NEXT_PUBLIC_SITE_URL=

# ─── Resend Email ──────────────────────────────────────────────────
# Required for project enquiry email delivery.
# Get your API key at https://resend.com
RESEND_API_KEY=

# Email address that will receive project enquiry notifications.
CONTACT_NOTIFICATION_EMAIL=

# Sender identity — must match a domain verified in your Resend account.
# Example: Oluwaseun Enquiries <hello@oluwaseun.dev>
# During testing, onboarding@resend.dev works without domain verification.
RESEND_FROM_EMAIL=Oluwaseun Enquiries <onboarding@resend.dev>

# ─── Rate Limiting (Optional — Recommended for Production) ─────────
# Upstash Redis REST credentials for cross-instance rate limiting.
# Without these, in-memory rate limiting is used (resets on restart).
# Get credentials at https://upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
